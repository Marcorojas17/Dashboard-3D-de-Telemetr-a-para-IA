            btnReport.addEventListener('click', generateReport);

            // ===== INICIALIZACIÓN =====
            addLog('[SISTEMA] KRONOS Compliance v8.0 cargado.', 'info');
            addLog('[ISO 27001] Controles de seguridad habilitados.', 'info');
            addLog('[ISO 27037] Cadena de custodia lista.', 'info');
            addLog('[NOM-151] Sistema de conservación activo.', 'info');
            addLog('[GDPR/HIPAA/PCI] Marcos de cumplimiento integrados.', 'info');
            setStatus('Sistema listo', '#7a7298', '');
            btnAudit.disabled = true;
            btnBrute.disabled = true;
            drawChart();

            // Redimensionar gráfico
            let resizeTimer;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(drawChart, 200);
            });

            // Datos iniciales para el gráfico
            for (let i = 0; i < 20; i++) chartData.push(Math.random() * 8);
            drawChart();

            console.log('🔒 KRONOS Compliance v8.0 · ISO/NOM/GDPR/HIPAA ready');
        })();
    </script>
</body>
</html>
