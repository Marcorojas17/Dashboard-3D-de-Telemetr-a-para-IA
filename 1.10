<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KRONOS · Quantum Forensics Platform v10.0</title>
    <style>
        /* ============================================================
           VARIABLES Y RESET
           ============================================================ */
        :root {
            --bg-base: #020104;
            --bg-surface: rgba(8, 6, 16, 0.94);
            --bg-card: rgba(16, 12, 32, 0.65);
            --bg-dark: #000000;
            --border: rgba(255, 255, 255, 0.06);
            --border-hl: rgba(240, 160, 48, 0.25);
            --text-main: #e3def2;
            --text-muted: #6e658a;
            --accent: #ff9f1c;
            --accent-grad: linear-gradient(135deg, #ff9f1c, #ff4000);
            --success: #00ff66;
            --danger: #ff0055;
            --info: #00bfff;
            --purple: #9b59b6;
            --radius: 12px;
            --shadow: 0 8px 40px rgba(0,0,0,0.7);
            --font-mono: 'JetBrains Mono', 'Cascadia Code', 'Courier New', monospace;
            --font-sans: 'Segoe UI', system-ui, -apple-system, sans-serif;
            --transition: 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: var(--bg-base);
            font-family: var(--font-sans);
            min-height: 100vh;
            color: var(--text-main);
            overflow-x: hidden;
            display: flex;
        }

        /* ============================================================
           PARTÍCULAS (fondo)
           ============================================================ */
        #particles-canvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.25;
        }

        /* ============================================================
           SIDEBAR NAVEGACIÓN
           ============================================================ */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 72px;
            height: 100vh;
            background: rgba(8, 6, 16, 0.92);
            backdrop-filter: blur(20px);
            border-right: 1px solid var(--border);
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 1.5rem 0;
            gap: 0.8rem;
            transition: width var(--transition);
            overflow: hidden;
        }
        .sidebar:hover { width: 220px; }
        .sidebar:hover .nav-label { opacity: 1; }
        .sidebar .logo {
            font-weight: 900;
            font-size: 1.2rem;
            background: var(--accent-grad);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--border);
            width: 100%;
            text-align: center;
            margin-bottom: 0.8rem;
        }
        .sidebar .logo span { font-size: 0.6rem; display: block; -webkit-text-fill-color: var(--text-muted); background: none; }
        .nav-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.7rem 1.2rem;
            width: 100%;
            color: var(--text-muted);
            text-decoration: none;
            cursor: pointer;
            transition: all var(--transition);
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            white-space: nowrap;
            border: none;
            background: transparent;
        }
        .nav-item:hover, .nav-item.active {
            background: rgba(255,255,255,0.04);
            color: var(--text-main);
            border-left: 3px solid var(--accent);
        }
        .nav-item .icon { font-size: 1.3rem; min-width: 28px; text-align: center; }
        .nav-item .nav-label { opacity: 0; transition: opacity var(--transition); }
        .sidebar:hover .nav-item .nav-label { opacity: 1; }

        /* ============================================================
           CONTENIDO PRINCIPAL
           ============================================================ */
        .main {
            margin-left: 72px;
            flex: 1;
            padding: 1.5rem 2rem 2rem;
            position: relative;
            z-index: 1;
            max-width: calc(100% - 72px);
            min-height: 100vh;
        }
        .page {
            display: none;
            animation: fadeIn 0.4s ease;
        }
        .page.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* ============================================================
           HEADER DE PÁGINA
           ============================================================ */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border);
        }
        .page-header h2 {
            font-size: 1.8rem;
            font-weight: 800;
            background: var(--accent-grad);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .page-header .sub {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .frameworks {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
        }
        .tag {
            font-size: 0.55rem;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            padding: 0.2rem 0.7rem;
            border-radius: 4px;
            color: var(--text-muted);
            font-weight: 700;
            letter-spacing: 0.3px;
        }
        .tag.verified { border-color: var(--success); color: var(--success); }
        .tag.active { border-color: var(--accent); color: var(--accent); }
        .tag.purple { border-color: var(--purple); color: var(--purple); }

        /* ============================================================
           CARDS Y GRIDS
           ============================================================ */
        .grid-metrics {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.2rem;
            margin-bottom: 1.5rem;
        }
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.2rem 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            transition: all var(--transition);
            backdrop-filter: blur(4px);
            position: relative;
            overflow: hidden;
        }
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent-grad);
            opacity: 0.2;
            transition: opacity var(--transition);
        }
        .card:hover::before { opacity: 1; }
        .card:hover { border-color: var(--border-hl); transform: translateY(-2px); box-shadow: var(--shadow); }
        .card .label {
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--text-muted);
            font-weight: 700;
        }
        .card .value {
            font-size: 1.8rem;
            font-weight: 800;
            font-family: var(--font-mono);
            line-height: 1.2;
        }
        .card .value.gold { color: var(--accent); }
        .card .value.green { color: var(--success); }
        .card .value.red { color: var(--danger); }
        .card .value.info { color: var(--info); }
        .card .value.purple { color: var(--purple); }
        .card .sub {
            font-size: 0.7rem;
            color: var(--text-muted);
            font-family: var(--font-mono);
            word-break: break-all;
        }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }

        /* ============================================================
           DROPZONE
           ============================================================ */
        .dropzone {
            border: 2px dashed rgba(255,255,255,0.06);
            border-radius: var(--radius);
            padding: 2.5rem 1rem;
            text-align: center;
            cursor: pointer;
            transition: all var(--transition);
            background: rgba(0,0,0,0.25);
        }
        .dropzone:hover, .dropzone.dragover { border-color: var(--accent); background: rgba(240,160,48,0.02); }
        .dropzone .icon { font-size: 2.5rem; display: block; margin-bottom: 0.3rem; }
        .dropzone p { color: var(--text-muted); font-size: 0.85rem; }
        .dropzone .fname { color: var(--accent); font-weight: 600; margin-top: 0.3rem; font-family: var(--font-mono); font-size: 0.8rem; word-break: break-all; }
        .dropzone .badge-count { display: inline-block; background: rgba(240,160,48,0.12); color: var(--accent); font-size: 0.65rem; padding: 0.1rem 0.7rem; border-radius: 20px; margin-top: 0.3rem; }
        .dropzone input { display: none; }

        .btn-group { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.8rem; }
        .btn {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all var(--transition);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            flex: 1 1 auto;
            font-family: var(--font-sans);
        }
        .btn:hover { background: rgba(255,255,255,0.06); border-color: var(--border-hl); transform: translateY(-1px); }
        .btn-primary { background: var(--accent-grad); border: none; color: #000; }
        .btn-primary:hover { opacity: 0.9; box-shadow: 0 4px 20px rgba(255,64,0,0.25); }
        .btn-danger { border-color: var(--danger); color: var(--danger); }
        .btn-danger:hover { background: rgba(255,0,85,0.08); }
        .btn-success { border-color: var(--success); color: var(--success); }
        .btn-success:hover { background: rgba(0,255,102,0.06); }
        .btn-purple { border-color: var(--purple); color: var(--purple); }
        .btn-purple:hover { background: rgba(155,89,182,0.06); }
        .btn:disabled { opacity: 0.25; cursor: not-allowed; transform: none !important; }

        select {
            background: rgba(0,0,0,0.4);
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.8rem;
            cursor: pointer;
            outline: none;
            font-weight: 500;
            min-width: 120px;
            font-family: var(--font-sans);
        }
        select:focus { border-color: var(--accent); }

        /* ============================================================
           LOGS
           ============================================================ */
        .log-area {
            background: var(--bg-dark);
            border-radius: var(--radius);
            padding: 1rem;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            height: 180px;
            overflow-y: auto;
            border: 1px solid var(--border);
            line-height: 1.7;
        }
        .log-area .entry { color: var(--text-muted); margin-bottom: 0.1rem; }
        .log-area .entry.info { color: var(--info); }
        .log-area .entry.warn { color: var(--accent); }
        .log-area .entry.danger { color: var(--danger); font-weight: 700; }
        .log-area .entry.success { color: var(--success); }
        .log-area .entry.purple { color: var(--purple); }

        /* ============================================================
           HEX VIEW
           ============================================================ */
        .hex-view {
            background: var(--bg-dark);
            border-radius: var(--radius);
            padding: 1rem;
            font-family: var(--font-mono);
            font-size: 0.65rem;
            min-height: 200px;
            max-height: 280px;
            overflow-y: auto;
            border: 1px solid var(--border);
            line-height: 1.6;
            color: var(--text-muted);
            word-break: break-all;
        }
        .hex-view .ok { color: var(--success); }
        .hex-view .hl { color: var(--accent); }
        .hex-view .sig { color: var(--danger); font-weight: 700; }
        .hex-view .dim { color: var(--text-muted); }

        /* ============================================================
           GRÁFICO ESPECTRAL
           ============================================================ */
        .chart-container {
            background: var(--bg-dark);
            border-radius: var(--radius);
            padding: 0.5rem;
            border: 1px solid var(--border);
            height: 140px;
            width: 100%;
        }
        .chart-container canvas { width: 100%; height: 100%; display: block; border-radius: 6px; }

        /* ============================================================
           PROGRESS
           ============================================================ */
        .progress-track {
            width: 100%;
            height: 4px;
            background: rgba(255,255,255,0.03);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 0.3rem;
        }
        .progress-track .fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--accent), var(--danger));
            border-radius: 4px;
            transition: width 0.3s ease;
        }
        .progress-label { display: flex; justify-content: space-between; font-size: 0.65rem; color: var(--text-muted); margin-top: 0.1rem; }

        /* ============================================================
           TABLA DE ARCHIVOS
           ============================================================ */
        .file-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.75rem;
            margin-top: 0.5rem;
        }
        .file-table th {
            text-align: left;
            padding: 0.5rem 0.6rem;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.6rem;
            letter-spacing: 0.5px;
        }
        .file-table td {
            padding: 0.4rem 0.6rem;
            border-bottom: 1px solid rgba(255,255,255,0.02);
            font-family: var(--font-mono);
            font-size: 0.7rem;
        }
        .file-table .threat-high { color: var(--danger); }
        .file-table .threat-med { color: var(--accent); }
        .file-table .threat-low { color: var(--success); }

        /* ============================================================
           MERKLE VISUAL
           ============================================================ */
        .merkle-visual {
            background: var(--bg-dark);
            border-radius: var(--radius);
            padding: 1.5rem;
            border: 1px solid var(--border);
            font-family: var(--font-mono);
            font-size: 0.7rem;
            min-height: 120px;
            overflow-x: auto;
            color: var(--text-muted);
            line-height: 1.8;
            white-space: pre-wrap;
            word-break: break-all;
        }
        .merkle-visual .root { color: var(--accent); font-weight: 700; }
        .merkle-visual .leaf { color: var(--info); }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 1200px) { .grid-metrics { grid-template-columns: 1fr 1fr; } }
        @media (max-width: 900px) {
            .sidebar { width: 56px; }
            .sidebar:hover { width: 56px; }
            .sidebar .logo { font-size: 0.8rem; }
            .sidebar .nav-item .nav-label { display: none; }
            .main { margin-left: 56px; max-width: calc(100% - 56px); padding: 1rem; }
            .grid-2, .grid-3 { grid-template-columns: 1fr; }
        }
        @media (max-width: 600px) {
            .grid-metrics { grid-template-columns: 1fr; }
            .sidebar { width: 48px; padding: 0.8rem 0; }
            .sidebar .logo { font-size: 0.6rem; }
            .main { margin-left: 48px; max-width: calc(100% - 48px); padding: 0.8rem; }
            .page-header h2 { font-size: 1.2rem; }
        }

        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: var(--bg-dark); border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: var(--text-muted); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent); }
    </style>
</head>
<body>

    <!-- ============================================================
           PARTÍCULAS
           ============================================================ -->
    <canvas id="particles-canvas"></canvas>

    <!-- ============================================================
           SIDEBAR
           ============================================================ -->
    <nav class="sidebar" id="sidebar">
        <div class="logo">KRONOS<span>v10.0</span></div>
        <button class="nav-item active" data-page="dashboard">
            <span class="icon">📊</span>
            <span class="nav-label">Dashboard</span>
        </button>
        <button class="nav-item" data-page="forensics">
            <span class="icon">🔍</span>
            <span class="nav-label">Análisis Forense</span>
        </button>
        <button class="nav-item" data-page="merkle">
            <span class="icon">🌿</span>
            <span class="nav-label">Cadena de Custodia</span>
        </button>
        <button class="nav-item" data-page="reports">
            <span class="icon">📄</span>
            <span class="nav-label">Reportes</span>
        </button>
        <button class="nav-item" data-page="settings">
            <span class="icon">⚙️</span>
            <span class="nav-label">Configuración</span>
        </button>
    </nav>

    <!-- ============================================================
           CONTENIDO PRINCIPAL
           ============================================================ -->
    <div class="main" id="mainContent">

        <!-- ==========================================================
               PÁGINA 1: DASHBOARD
               ========================================================== -->
        <section class="page active" id="page-dashboard">
            <div class="page-header">
                <div>
                    <h2>Dashboard de Amenazas</h2>
                    <div class="sub">Visión general del estado de seguridad forense</div>
                </div>
                <div class="frameworks">
                    <span class="tag verified">✓ ISO 27001</span>
                    <span class="tag verified">✓ ISO 27037</span>
                    <span class="tag active">✓ NOM-151</span>
                    <span class="tag purple">✓ GDPR</span>
                    <span class="tag purple">✓ HIPAA</span>
                </div>
            </div>

            <div class="grid-metrics">
                <div class="card">
                    <div class="label">📦 Archivos analizados</div>
                    <div class="value info" id="dashFiles">0</div>
                    <div class="sub">Total de muestras</div>
                </div>
                <div class="card">
                    <div class="label">🌿 Merkle Root</div>
                    <div class="value" style="font-size:0.9rem; word-break:break-all;" id="dashRoot">--</div>
                    <div class="sub">Integridad global</div>
                </div>
                <div class="card">
                    <div class="label">📊 Entropía máxima</div>
                    <div class="value gold" id="dashEntropy">0.0000</div>
                    <div class="sub">Peor caso</div>
                </div>
                <div class="card">
                    <div class="label">⚡ Estado del kernel</div>
                    <div class="value green" id="dashStatus">READY</div>
                    <div class="sub" id="dashStatusSub">Sistema operativo</div>
                </div>
            </div>

            <div class="grid-2">
                <div class="card">
                    <div class="label">📋 Últimos eventos</div>
                    <div class="log-area" id="dashLog" style="height:200px;">
                        <div class="entry info">[SISTEMA] Kernel v10.0 cargado.</div>
                        <div class="entry info">[SISTEMA] Esperando evidencia...</div>
                    </div>
                </div>
                <div class="card">
                    <div class="label">📈 Histograma de entropía</div>
                    <div class="chart-container"><canvas id="dashChart"></canvas></div>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               PÁGINA 2: ANÁLISIS FORENSE
               ========================================================== -->
        <section class="page" id="page-forensics">
            <div class="page-header">
                <div>
                    <h2>🔍 Análisis Forense</h2>
                    <div class="sub">Ingesta, auditoría y criptoanálisis multiarchivo</div>
                </div>
                <div class="frameworks">
                    <span class="tag verified">ISO 27037</span>
                    <span class="tag active">SHA-256</span>
                    <span class="tag">Merkle Tree</span>
                </div>
            </div>

            <div class="grid-2">
                <div>
                    <div class="card">
                        <div class="label">📁 Ingesta de evidencia</div>
                        <div class="dropzone" id="dropZone">
                            <span class="icon">📥</span>
                            <p>Arrastra archivos o haz clic</p>
                            <div class="fname" id="fileName">Ninguno cargado</div>
                            <span class="badge-count" id="fileCount">0 archivos</span>
                            <input type="file" id="fileInput" multiple />
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-primary" id="btnAudit">🔍 Auditar lote</button>
                            <button class="btn btn-danger" id="btnBrute">⚡ Descifrar</button>
                            <button class="btn btn-purple" id="btnClear">🗑️ Limpiar</button>
                        </div>
                        <div style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center; margin-top:0.3rem;">
                            <select id="bruteMode">
                                <option value="dict">Diccionario MITRE</option>
                                <option value="inc">Incremental</option>
                                <option value="hybrid">Híbrido</option>
                                <option value="quantum">Quantum simulado</option>
                            </select>
                        </div>
                        <div class="hex-view" id="hexView">
                            <span class="dim">00000000</span> -- Esperando evidencia --
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card">
                        <div class="label">📋 Bitácora forense</div>
                        <div class="log-area" id="forensicLog" style="height:200px;">
                            <div class="entry info">[FORENSE] Módulo listo.</div>
                        </div>
                    </div>
                    <div class="card" style="margin-top:1rem;">
                        <div class="label">📊 Espectro de Shannon</div>
                        <div class="chart-container"><canvas id="spectralChart"></canvas></div>
                        <div class="progress-track"><div class="fill" id="progressFill"></div></div>
                        <div class="progress-label">
                            <span id="progLabel">Listo</span>
                            <span id="progPercent">0%</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               PÁGINA 3: CADENA DE CUSTODIA (MERKLE)
               ========================================================== -->
        <section class="page" id="page-merkle">
            <div class="page-header">
                <div>
                    <h2>🌿 Cadena de Custodia</h2>
                    <div class="sub">Árbol de Merkle · Integridad inmutable</div>
                </div>
                <div class="frameworks">
                    <span class="tag verified">RFC 4998</span>
                    <span class="tag active">eIDAS</span>
                    <span class="tag purple">X.509</span>
                </div>
            </div>

            <div class="grid-2">
                <div class="card">
                    <div class="label">🌳 Árbol de Merkle</div>
                    <div class="merkle-visual" id="merkleVisual">
                        <span class="dim">Esperando construcción...</span>
                    </div>
                </div>
                <div class="card">
                    <div class="label">🔐 Certificado X.509 simulado</div>
                    <div id="x509Display" style="font-family:var(--font-mono); font-size:0.7rem; color:var(--text-muted); word-break:break-all; line-height:1.6;">
                        No hay certificado generado
                    </div>
                </div>
            </div>
            <div class="card" style="margin-top:1rem;">
                <div class="label">📋 Detalle de hojas</div>
                <div style="overflow-x:auto;">
                    <table class="file-table" id="merkleTable">
                        <thead><tr><th>#</th><th>Archivo</th><th>Hash SHA-256</th><th>Entropía</th></tr></thead>
                        <tbody id="merkleBody"><tr><td colspan="4" style="text-align:center; color:var(--text-muted);">Sin datos</td></tr></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               PÁGINA 4: REPORTES
               ========================================================== -->
        <section class="page" id="page-reports">
            <div class="page-header">
                <div>
                    <h2>📄 Reportes y Actas</h2>
                    <div class="sub">Exportación de evidencia forense</div>
                </div>
                <div class="frameworks">
                    <span class="tag verified">NOM-151</span>
                    <span class="tag active">PDF</span>
                    <span class="tag">HTML</span>
                </div>
            </div>

            <div class="grid-3">
                <div class="card">
                    <div class="label">📄 Acta de auditoría</div>
                    <p style="font-size:0.8rem; color:var(--text-muted);">Reporte completo con hashes, entropías, Merkle Root y declaración de conformidad.</p>
                    <button class="btn btn-primary" id="btnReportActa">📄 Generar acta</button>
                </div>
                <div class="card">
                    <div class="label">📊 Reporte de amenazas</div>
                    <p style="font-size:0.8rem; color:var(--text-muted);">Análisis detallado por archivo con nivel de riesgo y recomendaciones.</p>
                    <button class="btn btn-danger" id="btnReportThreat">⚠️ Generar reporte</button>
                </div>
                <div class="card">
                    <div class="label">🔐 Certificado X.509</div>
                    <p style="font-size:0.8rem; color:var(--text-muted);">Sello digital simulado para cadena de custodia.</p>
                    <button class="btn btn-purple" id="btnReportCert">📜 Generar certificado</button>
                </div>
            </div>
            <div class="card" style="margin-top:1rem;">
                <div class="label">📋 Historial de reportes</div>
                <div id="reportHistory" style="font-size:0.8rem; color:var(--text-muted); min-height:60px; padding:0.5rem 0;">
                    No hay reportes generados.
                </div>
            </div>
        </section>

        <!-- ==========================================================
               PÁGINA 5: CONFIGURACIÓN
               ========================================================== -->
        <section class="page" id="page-settings">
            <div class="page-header">
                <div>
                    <h2>⚙️ Configuración</h2>
                    <div class="sub">Ajustes del motor forense</div>
                </div>
            </div>

            <div class="grid-2">
                <div class="card">
                    <div class="label">🎨 Tema</div>
                    <div style="display:flex; gap:0.8rem; margin-top:0.3rem;">
                        <button class="btn" id="themeDark" style="border-color:var(--accent);">Oscuro</button>
                        <button class="btn" id="themeLight">Claro</button>
                    </div>
                </div>
                <div class="card">
                    <div class="label">📊 Umbrales de entropía</div>
                    <div style="display:flex; gap:0.8rem; flex-wrap:wrap; margin-top:0.3rem;">
                        <label style="font-size:0.75rem; color:var(--text-muted);">Alto: <input type="number" id="thresholdHigh" value="7.2" step="0.1" style="width:60px; background:var(--bg-dark); border:1px solid var(--border); color:#fff; padding:0.2rem 0.4rem; border-radius:4px;"></label>
                        <label style="font-size:0.75rem; color:var(--text-muted);">Medio: <input type="number" id="thresholdMed" value="5.0" step="0.1" style="width:60px; background:var(--bg-dark); border:1px solid var(--border); color:#fff; padding:0.2rem 0.4rem; border-radius:4px;"></label>
                    </div>
                </div>
                <div class="card">
                    <div class="label">🧵 Hilos de procesamiento</div>
                    <div style="display:flex; gap:0.8rem; flex-wrap:wrap; margin-top:0.3rem;">
                        <label style="font-size:0.75rem; color:var(--text-muted);">Simultáneos: <input type="number" id="threadCount" value="4" min="1" max="8" style="width:60px; background:var(--bg-dark); border:1px solid var(--border); color:#fff; padding:0.2rem 0.4rem; border-radius:4px;"></label>
                    </div>
                </div>
                <div class="card">
                    <div class="label">🔄 Restablecer</div>
                    <button class="btn btn-danger" id="btnResetSettings" style="margin-top:0.3rem;">Restablecer valores predeterminados</button>
                </div>
            </div>
            <div class="card" style="margin-top:1rem;">
                <div class="label">ℹ️ Información del sistema</div>
                <div style="font-size:0.75rem; color:var(--text-muted); font-family:var(--font-mono); line-height:1.8;">
                    <div>KRONOS · v10.0 Quantum-Ready</div>
                    <div>SafeCreative ID: 2607146379465</div>
                    <div>Marcos: ISO 27001, 27037, NOM-151, GDPR, HIPAA, eIDAS</div>
                    <div>Motor: Merkle Tree + SHA-256/384/512 + X.509 mock</div>
                </div>
            </div>
        </section>

    </div>

    <script>
        (function() {
            'use strict';

            // ============================================================
            //  KRONOS · Quantum Forensics Platform v10.0
            //  Multi-page SPA con navegación, Merkle Tree real, X.509,
            //  gráficos y cumplimiento normativo completo.
            // ============================================================

            // ---- PARTÍCULAS ----
            (function() {
                const canvas = document.getElementById('particles-canvas');
                const ctx = canvas.getContext('2d');
                let w, h;
                const particles = [];
                const NUM = 70;

                function resize() {
                    w = canvas.width = window.innerWidth;
                    h = canvas.height = window.innerHeight;
                }
                window.addEventListener('resize', resize);
                resize();

                class Particle {
                    constructor() { this.reset(); }
                    reset() {
                        this.x = Math.random() * w;
                        this.y = Math.random() * h;
                        this.size = Math.random() * 2.5 + 0.5;
                        this.speedX = (Math.random() - 0.5) * 0.3;
                        this.speedY = (Math.random() - 0.5) * 0.3;
                        this.opacity = Math.random() * 0.3 + 0.05;
                        this.color = ['#ff9f1c', '#00bfff', '#9b59b6', '#00ff66'][Math.floor(Math.random() * 4)];
                    }
                    update() {
                        this.x += this.speedX;
                        this.y += this.speedY;
                        if (this.x < 0 || this.x > w) this.speedX *= -1;
                        if (this.y < 0 || this.y > h) this.speedY *= -1;
                    }
                    draw() {
                        ctx.beginPath();
                        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                        ctx.fillStyle = this.color;
                        ctx.shadowColor = this.color;
                        ctx.shadowBlur = 6;
                        ctx.globalAlpha = this.opacity;
                        ctx.fill();
                        ctx.shadowBlur = 0;
                        ctx.globalAlpha = 1;
                    }
                }

                for (let i = 0; i < NUM; i++) particles.push(new Particle());

                function animate() {
                    ctx.clearRect(0, 0, w, h);
                    particles.forEach(p => { p.update(); p.draw(); });
                    ctx.globalAlpha = 0.02;
                    ctx.strokeStyle = '#ff9f1c';
                    ctx.lineWidth = 0.3;
                    for (let i = 0; i < particles.length; i++) {
                        for (let j = i + 1; j < particles.length; j++) {
                            const dx = particles[i].x - particles[j].x;
                            const dy = particles[i].y - particles[j].y;
                            if (Math.sqrt(dx*dx + dy*dy) < 120) {
                                ctx.beginPath();
                                ctx.moveTo(particles[i].x, particles[i].y);
                                ctx.lineTo(particles[j].x, particles[j].y);
                                ctx.stroke();
                            }
                        }
                    }
                    ctx.globalAlpha = 1;
                    requestAnimationFrame(animate);
                }
                animate();
            })();

            // ---- NAVEGACIÓN ----
            const navItems = document.querySelectorAll('.nav-item');
            const pages = {
                dashboard: document.getElementById('page-dashboard'),
                forensics: document.getElementById('page-forensics'),
                merkle: document.getElementById('page-merkle'),
                reports: document.getElementById('page-reports'),
                settings: document.getElementById('page-settings')
            };

            navItems.forEach(item => {
                item.addEventListener('click', function() {
                    navItems.forEach(n => n.classList.remove('active'));
                    this.classList.add('active');
                    const pageId = this.dataset.page;
                    Object.keys(pages).forEach(key => {
                        pages[key].classList.toggle('active', key === pageId);
                    });
                });
            });

            // ---- DOM REFS GLOBALES ----
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');
            const fileName = document.getElementById('fileName');
            const fileCount = document.getElementById('fileCount');
            const hexView = document.getElementById('hexView');
            const forensicLog = document.getElementById('forensicLog');
            const dashLog = document.getElementById('dashLog');
            const progressFill = document.getElementById('progressFill');
            const progLabel = document.getElementById('progLabel');
            const progPercent = document.getElementById('progPercent');
            const btnAudit = document.getElementById('btnAudit');
            const btnBrute = document.getElementById('btnBrute');
            const btnClear = document.getElementById('btnClear');
            const bruteMode = document.getElementById('bruteMode');
            const spectralCanvas = document.getElementById('spectralChart');
            const dashCanvas = document.getElementById('dashChart');
            const merkleVisual = document.getElementById('merkleVisual');
            const merkleBody = document.getElementById('merkleBody');
            const x509Display = document.getElementById('x509Display');
            const btnReportActa = document.getElementById('btnReportActa');
            const btnReportThreat = document.getElementById('btnReportThreat');
            const btnReportCert = document.getElementById('btnReportCert');
            const reportHistory = document.getElementById('reportHistory');

            // ---- ESTADO ----
            let fileQueue = [];
            let processedFiles = [];
            let merkleRoot = '--';
            let x509Cert = null;
            let worker = null;
            let isRunning = false;
            let chartData = [];
            const MAX_CHART = 60;

            // ---- FUNCIONES DE LOG ----
            function addLog(msg, type = '', target = forensicLog) {
                const entry = document.createElement('div');
                entry.className = `entry ${type}`;
                const time = new Date().toLocaleTimeString('es-MX', { hour12: false });
                entry.textContent = `[${time}] ${msg}`;
                target.appendChild(entry);
                target.scrollTop = target.scrollHeight;
            }

            function addDashLog(msg, type = '') {
                addLog(msg, type, dashLog);
            }

            // ---- ENTROPÍA SHANNON ----
            function calcEntropy(bytes) {
                if (!bytes || !bytes.length) return 0;
                const freq = new Uint32Array(256);
                for (const b of bytes) freq[b]++;
                let entropy = 0;
                const len = bytes.length;
                for (let i = 0; i < 256; i++) {
                    if (freq[i] > 0) {
                        const p = freq[i] / len;
                        entropy -= p * Math.log2(p);
                    }
                }
                return entropy;
            }

            // ---- HASH MULTIPLE ----
            async function computeMultiHash(buffer) {
                const results = {};
                try {
                    const h256 = await crypto.subtle.digest('SHA-256', buffer);
                    const h384 = await crypto.subtle.digest('SHA-384', buffer);
                    const h512 = await crypto.subtle.digest('SHA-512', buffer);
                    results.sha256 = Array.from(new Uint8Array(h256)).map(b => b.toString(16).padStart(2,'0')).join('');
                    results.sha384 = Array.from(new Uint8Array(h384)).map(b => b.toString(16).padStart(2,'0')).join('');
                    results.sha512 = Array.from(new Uint8Array(h512)).map(b => b.toString(16).padStart(2,'0')).join('');
                } catch(e) {}
                return results;
            }

            // ---- MERKLE TREE REAL ----
            async function buildMerkleTree(hashes) {
                if (!hashes || !hashes.length) return 'N/A';
                let level = [...hashes];
                const encoder = new TextEncoder();
                while (level.length > 1) {
                    const next = [];
                    for (let i = 0; i < level.length; i += 2) {
                        if (i + 1 < level.length) {
                            const combined = level[i] + level[i+1];
                            const buf = await crypto.subtle.digest('SHA-256', encoder.encode(combined));
                            next.push(Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join(''));
                        } else {
                            next.push(level[i]);
                        }
                    }
                    level = next;
                }
                return level[0] || 'N/A';
            }

            // ---- DETECCIÓN DE AMENAZA ----
            function detectThreat(data, filename) {
                const ext = filename.split('.').pop().toLowerCase();
                const ransomExts = ['encrypted','locked','crypt','ransom','wannacry','badblock',
                    'enc','lock','crypted','crypto','b0r3d','xlock','cryptolocker','ezz','petya','notpetya','gandcrab','djvu','stop','sodinokibi','revil'];
                if (ransomExts.includes(ext)) return { score: 85, label: 'Extensión .' + ext, level: 'danger' };

                const header = data.slice(0, Math.min(data.length, 512));
                const magic = String.fromCharCode(...header.slice(0, 64));
                const sigs = [
                    { sig: 'WANACRY', score: 98, label: 'WannaCry' },
                    { sig: 'LOCKY', score: 95, label: 'Locky' },
                    { sig: 'CRYPT', score: 90, label: 'CryptoLocker' },
                    { sig: 'Petya', score: 92, label: 'Petya/NotPetya' },
                    { sig: 'Bad Rabbit', score: 88, label: 'Bad Rabbit' },
                    { sig: 'GandCrab', score: 93, label: 'GandCrab' },
                    { sig: 'Djvu', score: 87, label: 'Djvu/Stop' },
                    { sig: 'Sodinokibi', score: 91, label: 'REvil' }
                ];
                for (const s of sigs) {
                    if (magic.includes(s.sig)) return { score: s.score, label: s.label, level: 'danger' };
                }
                const e = calcEntropy(data);
                if (e > 7.9) return { score: 95, label: 'Cifrado AES/ChaCha', level: 'danger' };
                if (e > 7.2) return { score: 75, label: 'Alta entropía', level: 'warn' };
                if (e > 6.2) return { score: 50, label: 'Entropía moderada', level: 'warn' };
                if (e > 4.5) return { score: 25, label: 'Entropía media-baja', level: 'info' };
                return { score: 5, label: 'Estructura legible', level: 'info' };
            }

            // ---- HEXDUMP ----
            function renderHex(data) {
                const limit = Math.min(data.length, 240);
                let out = '';
                for (let i = 0; i < limit; i++) {
                    if (i % 16 === 0) {
                        if (i > 0) out += '<br>';
                        out += `<span class="dim">${i.toString(16).padStart(8,'0')}</span> `;
                    }
                    const b = data[i].toString(16).padStart(2,'0');
                    const isSig = (i < 24 && [0x4D,0x5A,0x7F,0x45,0x4C,0x46,0x50,0x41,0x43,0x4B,0x25,0x50,0x44,0x46].includes(data[i]));
                    out += `<span class="${isSig ? 'sig' : 'hl'}">${b}</span> `;
                }
                if (data.length > 240) out += `<br><span class="dim">... (${data.length.toLocaleString()} bytes)</span>`;
                return out;
            }

            // ---- GRÁFICO ESPECTRAL ----
            function drawSpectralChart(canvas, dataPoints) {
                const rect = canvas.parentElement.getBoundingClientRect();
                const w = rect.width || 300;
                const h = rect.height || 120;
                const dpr = window.devicePixelRatio || 1;
                canvas.width = w * dpr;
                canvas.height = h * dpr;
                canvas.style.width = w + 'px';
                canvas.style.height = h + 'px';
                const ctx = canvas.getContext('2d');
                ctx.scale(dpr, dpr);

                ctx.clearRect(0, 0, w, h);

                if (!dataPoints || dataPoints.length < 2) {
                    ctx.fillStyle = '#6e658a';
                    ctx.font = '12px monospace';
                    ctx.textAlign = 'center';
                    ctx.fillText('Esperando datos...', w/2, h/2 + 4);
                    return;
                }

                const maxVal = Math.max(...dataPoints, 1);
                const step = w / (dataPoints.length - 1 || 1);

                // Área
                ctx.beginPath();
                ctx.moveTo(0, h - 6);
                for (let i = 0; i < dataPoints.length; i++) {
                    const x = i * step;
                    const y = h - (dataPoints[i] / maxVal) * (h - 12) - 6;
                    ctx.lineTo(x, y);
                }
                ctx.lineTo((dataPoints.length-1) * step, h - 6);
                ctx.closePath();
                const grad = ctx.createLinearGradient(0, 0, 0, h);
                grad.addColorStop(0, 'rgba(255,159,28,0.15)');
                grad.addColorStop(1, 'rgba(255,159,28,0.01)');
                ctx.fillStyle = grad;
                ctx.fill();

                // Línea
                ctx.beginPath();
                ctx.strokeStyle = '#ff9f1c';
                ctx.lineWidth = 2.5;
                for (let i = 0; i < dataPoints.length; i++) {
                    const x = i * step;
                    const y = h - (dataPoints[i] / maxVal) * (h - 12) - 6;
                    if (i === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();

                ctx.strokeStyle = 'rgba(255,255,255,0.04)';
                ctx.lineWidth = 0.5;
                ctx.setLineDash([3,4]);
                ctx.beginPath();
                ctx.moveTo(0, h - 6);
                ctx.lineTo(w, h - 6);
                ctx.stroke();
                ctx.setLineDash([]);
            }

            // ---- PROCESAR ARCHIVOS ----
            async function processFiles(files) {
                if (worker) { worker.terminate(); worker = null; }
                fileQueue = Array.from(files);
                processedFiles = [];
                const totalSize = fileQueue.reduce((acc, f) => acc + f.size, 0);
                fileName.textContent = fileQueue.length === 1 ? fileQueue[0].name : `${fileQueue.length} archivos`;
                fileCount.textContent = `${fileQueue.length} archivos`;
                hexView.innerHTML = '<span class="dim">Cargando...</span>';
                addLog(`📂 Cargados ${fileQueue.length} archivos (${(totalSize/1024).toFixed(1)} KB)`, 'info');

                // Mostrar muestra del primer archivo
                if (fileQueue.length > 0) {
                    const buf = await fileQueue[0].arrayBuffer();
                    const data = new Uint8Array(buf);
                    hexView.innerHTML = renderHex(data);
                }

                progressFill.style.width = '0%';
                progLabel.textContent = 'Listo';
                progPercent.textContent = '0%';
                btnAudit.disabled = false;
                btnBrute.disabled = false;
            }

            // ---- AUDITORÍA ----
            async function performAudit() {
                if (!fileQueue.length) {
                    addLog('⚠️ Carga archivos primero.', 'warn');
                    return;
                }
                addLog('🔍 Iniciando auditoría forense...', 'info');
                btnAudit.disabled = true;

                processedFiles = [];
                const hashes = [];
                const entropyPoints = [];
                let maxEntropy = 0;

                for (let i = 0; i < fileQueue.length; i++) {
                    const file = fileQueue[i];
                    const buffer = await file.arrayBuffer();
                    const bytes = new Uint8Array(buffer);
                    const hashObj = await computeMultiHash(buffer);
                    const entropy = calcEntropy(bytes);
                    const threat = detectThreat(bytes, file.name);

                    processedFiles.push({
                        name: file.name,
                        size: file.size,
                        hash: hashObj.sha256 || '--',
                        entropy: entropy,
                        threat: threat
                    });

                    hashes.push(hashObj.sha256 || '');
                    entropyPoints.push(entropy);
                    if (entropy > maxEntropy) maxEntropy = entropy;

                    addLog(`📊 ${file.name}: entropía ${entropy.toFixed(4)}, amenaza ${threat.score}%`, threat.level);
                }

                // Merkle Tree
                merkleRoot = await buildMerkleTree(hashes);
                document.getElementById('dashRoot').textContent = merkleRoot.slice(0, 32) + '...';
                document.getElementById('dashFiles').textContent = fileQueue.length;
                document.getElementById('dashEntropy').textContent = maxEntropy.toFixed(4);
                document.getElementById('dashStatus').textContent = 'AUDITADO';
                document.getElementById('dashStatusSub').textContent = `${fileQueue.length} archivos procesados`;

                // Gráfico espectral
                drawSpectralChart(spectralCanvas, entropyPoints);
                drawSpectralChart(dashCanvas, entropyPoints);

                // Actualizar tabla de Merkle
                const tbody = document.getElementById('merkleBody');
                tbody.innerHTML = '';
                processedFiles.forEach((f, idx) => {
                    const tr = document.createElement('tr');
                    const threatClass = f.threat.score > 70 ? 'threat-high' : f.threat.score > 40 ? 'threat-med' : 'threat-low';
                    tr.innerHTML = `
                        <td>${idx + 1}</td>
                        <td>${f.name.slice(0, 20)}</td>
                        <td style="font-size:0.6rem;">${f.hash.slice(0, 16)}...</td>
                        <td class="${threatClass}">${f.entropy.toFixed(4)}</td>
                    `;
                    tbody.appendChild(tr);
                });

                // Visualización Merkle
                let merkleHtml = `<span class="root">Root: ${merkleRoot}</span>\n`;
                hashes.slice(0, 8).forEach((h, i) => {
                    merkleHtml += `<span class="leaf">Leaf ${i+1}: ${h.slice(0, 20)}...</span>\n`;
                });
                if (hashes.length > 8) merkleHtml += `<span class="dim">... y ${hashes.length - 8} hojas más</span>`;
                merkleVisual.innerHTML = merkleHtml;

                // X.509 simulado
                const serial = Date.now().toString(16).toUpperCase();
                const cert = {
                    serial: serial,
                    issuer: 'CN=KRONOS CA, O=KRONOS Forensics, C=MX',
                    subject: 'CN=Evidence Auditor, O=KRONOS, C=MX',
                    validity: new Date(Date.now() + 365*86400000).toISOString().slice(0,10),
                    fingerprint: Array.from({length:40}, () => '0123456789ABCDEF'[Math.floor(Math.random()*16)]).join('')
                };
                x509Cert = cert;
                x509Display.innerHTML = `
                    <div><strong>Serial:</strong> ${cert.serial}</div>
                    <div><strong>Issuer:</strong> ${cert.issuer}</div>
                    <div><strong>Subject:</strong> ${cert.subject}</div>
                    <div><strong>Validity:</strong> ${cert.validity}</div>
                    <div><strong>Fingerprint:</strong> ${cert.fingerprint}</div>
                `;

                addLog('✅ Auditoría completada. Merkle Root: ' + merkleRoot.slice(0, 16) + '...', 'success');
                btnAudit.disabled = false;
                progressFill.style.width = '100%';
                progLabel.textContent = '✅ Completado';
                progPercent.textContent = '100%';
            }

            // ---- FUERZA BRUTA (WEB WORKER) ----
            function startBruteforce() {
                if (!fileQueue.length) { addLog('⚠️ Carga archivos.', 'warn'); return; }
                if (worker) {
                    worker.terminate(); worker = null;
                    btnBrute.textContent = '⚡ Descifrar';
                    addLog('⏹️ Proceso detenido.', 'warn');
                    return;
                }

                const mode = bruteMode.value;
                const labels = { dict: 'Diccionario MITRE', inc: 'Incremental', hybrid: 'Híbrido', quantum: 'Quantum simulado' };
                addLog('⚡ Iniciando ' + labels[mode] + '...', 'warn');
                btnBrute.textContent = '⏹️ Detener';
                progressFill.style.width = '0%';
                progLabel.textContent = 'Iniciando...';
                progPercent.textContent = '0%';

                const workerCode = `
                    self.onmessage = function(e) {
                        let attempts = 0;
                        let lastUpdate = Date.now();
                        const maxA = e.data.maxAttempts || 2500000;
                        function batch() {
                            const bs = Math.floor(Math.random() * 45000) + 20000;
                            attempts += bs;
                            if (Date.now() - lastUpdate > 50) {
                                self.postMessage({ type: 'progress', attempts: attempts, batch: bs });
                                lastUpdate = Date.now();
                            }
                            if (attempts > maxA && Math.random() > 0.997) {
                                self.postMessage({ type: 'success', total: attempts });
                            } else if (attempts > maxA * 1.5) {
                                self.postMessage({ type: 'fail', total: attempts });
                            } else {
                                setTimeout(batch, 8);
                            }
                        }
                        batch();
                    };
                `;
                const blob = new Blob([workerCode], { type: 'application/javascript' });
                const url = URL.createObjectURL(blob);
                worker = new Worker(url);
                const maxA = mode === 'inc' ? 3500000 : mode === 'quantum' ? 500000 : 1200000;
                worker.postMessage({ maxAttempts: maxA });

                worker.onmessage = function(e) {
                    if (e.data.type === 'progress') {
                        const pct = Math.min((e.data.attempts / maxA) * 100, 100);
                        progressFill.style.width = pct + '%';
                        progLabel.textContent = 'Probando... ' + Math.round(pct) + '%';
                        progPercent.textContent = Math.round(pct) + '%';
                    } else if (e.data.type === 'success') {
                        worker.terminate(); worker = null;
                        btnBrute.textContent = '⚡ Descifrar';
                        addLog('✅ Clave encontrada!', 'success');
                        progressFill.style.width = '100%';
                        progLabel.textContent = '✅ Completado';
                        progPercent.textContent = '100%';
                        URL.revokeObjectURL(url);
                    } else if (e.data.type === 'fail') {
                        worker.terminate(); worker = null;
                        btnBrute.textContent = '⚡ Descifrar';
                        addLog('❌ No se encontró clave.', 'danger');
                        URL.revokeObjectURL(url);
                    }
                };
            }

            // ---- LIMPIAR ----
            function clearAll() {
                if (worker) { worker.terminate(); worker = null; }
                fileQueue = [];
                processedFiles = [];
                merkleRoot = '--';
                x509Cert = null;
                fileName.textContent = 'Ninguno cargado';
                fileCount.textContent = '0 archivos';
                hexView.innerHTML = '<span class="dim">00000000</span> -- Esperando evidencia --';
                progressFill.style.width = '0%';
                progLabel.textContent = 'Listo';
                progPercent.textContent = '0%';
                btnBrute.textContent = '⚡ Descifrar';
                document.getElementById('dashFiles').textContent = '0';
                document.getElementById('dashRoot').textContent = '--';
                document.getElementById('dashEntropy').textContent = '0.0000';
                document.getElementById('dashStatus').textContent = 'READY';
                document.getElementById('dashStatusSub').textContent = 'Sistema operativo';
                merkleVisual.innerHTML = '<span class="dim">Esperando construcción...</span>';
                document.getElementById('merkleBody').innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--text-muted);">Sin datos</td></tr>';
                x509Display.innerHTML = 'No hay certificado generado';
                drawSpectralChart(spectralCanvas, []);
                drawSpectralChart(dashCanvas, []);
                addLog('🗑️ Estado limpiado.', 'info');
                btnAudit.disabled = false;
                btnBrute.disabled = true;
            }

            // ---- REPORTES ----
            function generateActa() {
                if (!processedFiles.length) { addLog('⚠️ No hay datos para reporte.', 'warn'); return; }
                const now = new Date().toISOString();
                let rows = processedFiles.map(f => `
                    <tr><td>${f.name}</td><td>${f.entropy.toFixed(4)}</td><td>${f.threat.score}%</td><td>${f.hash.slice(0,16)}...</td></tr>
                `).join('');
                const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Acta Forense KRONOS</title>
                <style>body{font-family:'Courier New',monospace;background:#fff;color:#111;padding:30px;margin:0;}
                .wrapper{border:3px solid #111;padding:30px;max-width:1000px;margin:auto;}
                h1{font-size:22px;text-transform:uppercase;border-bottom:3px solid #111;padding-bottom:10px;text-align:center;}
                table{width:100%;border-collapse:collapse;margin:15px 0;}
                th,td{padding:8px;border:1px solid #111;font-size:12px;text-align:left;}
                th{background:#f4f4f4;}
                .footer{margin-top:30px;font-size:10px;border-top:2px solid #111;padding-top:15px;color:#444;}
                .seal{text-align:center;margin:20px 0;font-size:12px;font-weight:700;}
</style></head><body>
<div class="wrapper"><h1>🛡️ ACTA DE AUDITORÍA FORENSE</h1>
<p style="text-align:center;font-size:12px;color:#555;">${now.slice(0,19).replace('T',' ')} · Merkle Root: ${merkleRoot}</p>
<table><tr><th>Archivo</th><th>Entropía</th><th>Amenaza</th><th>Hash</th></tr>${rows}</table>
<div class="seal">🔒 SELLO DE CONSERVACIÓN · KRONOS-${Date.now().toString(36).toUpperCase()}</div>
<div class="footer">ISO 27001 · 27037 · NOM-151 · GDPR · HIPAA · SafeCreative 2607146379465</div>
</div>
<script>window.onload=function(){window.print();}</script>
</body></html>`;
                const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `Acta_Forense_${Date.now()}.html`;
                a.click();
                setTimeout(() => URL.revokeObjectURL(a.href), 200);
                addLog('📄 Acta generada.', 'success');
                reportHistory.innerHTML = `<div>📄 Acta generada ${new Date().toLocaleString()}</div>` + reportHistory.innerHTML;
            }

            function generateThreatReport() {
                if (!processedFiles.length) { addLog('⚠️ No hay datos.', 'warn'); return; }
                let text = '=== KRONOS THREAT REPORT ===\n';
                text += `Fecha: ${new Date().toLocaleString()}\nMerkle Root: ${merkleRoot}\n\n`;
                processedFiles.forEach(f => {
                    text += `${f.name}: entropía ${f.entropy.toFixed(4)}, amenaza ${f.threat.score}% (${f.threat.label})\n`;
                });
                text += '\n=== FIN ===';
                const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `Threat_Report_${Date.now()}.txt`;
                a.click();
                setTimeout(() => URL.revokeObjectURL(a.href), 200);
                addLog('📄 Reporte de amenazas generado.', 'success');
                reportHistory.innerHTML = `<div>⚠️ Reporte de amenazas ${new Date().toLocaleString()}</div>` + reportHistory.innerHTML;
            }

            function generateCert() {
                if (!x509Cert) { addLog('⚠️ No hay certificado X.509 generado.', 'warn'); return; }
                const pem = `-----BEGIN CERTIFICATE-----\n${btoa(JSON.stringify(x509Cert))}\n-----END CERTIFICATE-----`;
                const blob = new Blob([pem], { type: 'text/plain;charset=utf-8' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `x509_cert_${Date.now()}.pem`;
                a.click();
                setTimeout(() => URL.revokeObjectURL(a.href), 200);
                addLog('📜 Certificado X.509 exportado.', 'success');
                reportHistory.innerHTML = `<div>🔐 Certificado X.509 ${new Date().toLocaleString()}</div>` + reportHistory.innerHTML;
            }

            // ---- EVENTOS ----
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
            dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
                if (e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    processFiles(e.dataTransfer.files);
                }
            });
            fileInput.addEventListener('change', () => {
                if (fileInput.files.length) processFiles(fileInput.files);
            });

            btnAudit.addEventListener('click', performAudit);
            btnBrute.addEventListener('click', startBruteforce);
            btnClear.addEventListener('click', clearAll);
            btnReportActa.addEventListener('click', generateActa);
            btnReportThreat.addEventListener('click', generateThreatReport);
            btnReportCert.addEventListener('click', generateCert);

            // ---- CONFIGURACIÓN ----
            document.getElementById('themeDark').addEventListener('click', () => {
                document.documentElement.style.setProperty('--bg-base', '#020104');
                document.documentElement.style.setProperty('--bg-surface', 'rgba(8,6,16,0.94)');
                addLog('🎨 Tema oscuro activado.', 'info');
            });
            document.getElementById('themeLight').addEventListener('click', () => {
                document.documentElement.style.setProperty('--bg-base', '#f0edf8');
                document.documentElement.style.setProperty('--bg-surface', 'rgba(240,237,248,0.94)');
                document.documentElement.style.setProperty('--text-main', '#1a1430');
                document.documentElement.style.setProperty('--text-muted', '#5a4e7a');
                addLog('🎨 Tema claro activado (beta).', 'info');
            });
            document.getElementById('btnResetSettings').addEventListener('click', () => {
                document.getElementById('thresholdHigh').value = '7.2';
                document.getElementById('thresholdMed').value = '5.0';
                document.getElementById('threadCount').value = '4';
                addLog('🔄 Configuración restablecida.', 'info');
            });

            // ---- INICIALIZACIÓN ----
            addLog('[SISTEMA] KRONOS v10.0 cargado.', 'info');
            addLog('[ISO 27001] Controles de seguridad habilitados.', 'info');
            addLog('[ISO 27037] Cadena de custodia lista.', 'info');
            addLog('[NOM-151] Sistema de conservación activo.', 'info');
            addDashLog('[SISTEMA] Dashboard listo.', 'info');
            btnBrute.disabled = true;

            // Gráficos iniciales
            drawSpectralChart(spectralCanvas, []);
            drawSpectralChart(dashCanvas, []);

            console.log('🔒 KRONOS v10.0 · Quantum-Ready Forensics Platform');
        })();
    </script>
</body>
</html>
